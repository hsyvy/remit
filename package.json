{
  "name": "remit",
  "version": "0.1.0",
  "description": "A spending wallet for AI agents. The agent spends only what you approved on PayPal.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server/main.ts",
    "start": "tsx --env-file-if-exists=.env src/server/main.ts",
    "mcp": "tsx --env-file-if-exists=.env src/mcp/main.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "sandbox-check": "tsx --env-file-if-exists=.env scripts/sandbox-check.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec 'test/**/*.test.ts'",
    "purpose-eval": "tsx --env-file-if-exists=.env scripts/purpose-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
