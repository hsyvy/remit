# Copy to .env and fill in. Every key is optional: without one, that part runs in a local stand-in mode.

# Public base URL of the web app. PayPal sends the buyer back here after approval. On Render it defaults to RENDER_EXTERNAL_URL.
APP_URL=http://localhost:3000
PORT=3000

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
# Unset: approvals go through a local simulated checkout page instead of PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Claude, for the agent and the purpose check on each purchase.
ANTHROPIC_API_KEY=
# REMIT_MODEL=claude-opus-5-5
# REMIT_REVIEWER=on    # the purchase purpose check; "off" skips it

# Channel3 product search (use promo code PAYPAL-HACKATHON-2026).
# Unset: search uses a small built-in demo catalog.
CHANNEL3_API_KEY=

# Bearer token for the agent API that the MCP server calls. Unset: the agent API is off.
REMIT_AGENT_TOKEN=

# Largest single budget or top-up request the wallet accepts, in dollars.
REMIT_MAX_REQUEST=500

# Rupees per dollar, for the approximate ₹ figure shown next to dollar amounts. PayPal holds and captures stay in USD
# (PayPal doesn't accept INR). Set to 0 to show dollars only.
REMIT_INR_RATE=88

# REMIT_DB=data/remit.db

# Password for the owner's web app (user "owner"). Optional on localhost; the server won't start with a public APP_URL without it.
REMIT_OWNER_PASSWORD=
